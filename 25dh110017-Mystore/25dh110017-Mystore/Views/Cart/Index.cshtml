@model _25dh110017_Mystore.Models.Cart.Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:30px; margin-bottom:50px;">
    <h2><i class="glyphicon glyphicon-shopping-cart"></i> Giỏ hàng của bạn</h2>
    <hr />

    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr class="active table-light">
                    <th class="text-center" style="width:100px;">Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-end text-right">Đơn giá</th>
                    <th class="text-center" style="width:160px;">Số lượng</th>
                    <th class="text-end text-right">Thành tiền</th>
                    <th class="text-center" style="width:110px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@(item.product.ProductImage != null && item.product.ProductImage.StartsWith("http") ? item.product.ProductImage : Url.Content("~/Images/" + item.product.ProductImage))"
                                 alt="@item.product.ProductName"
                                 style="width:60px; height:60px; object-fit:cover;"
                                 class="rounded border"
                                 onerror="this.src='https://picsum.photos/seed/@item.product.ProductID/60/60'" />
                        </td>
                        <td class="align-middle">
                            <strong>@item.product.ProductName</strong>
                        </td>
                        <td class="text-end text-right align-middle font-weight-bold">
                            @item.product.ProductPrice.ToString("N0") VNĐ
                        </td>
                        <td class="text-center align-middle">
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex justify-content-center align-items-center" }))
                            {
                                @Html.Hidden("productID", item.product.ProductID)
                                <input type="number" name="quantity" value="@item.quantity" min="1" max="100" class="form-control form-control-sm input-sm me-1" style="width:65px; display:inline-block;" />
                                <button type="submit" class="btn btn-primary btn-sm" title="Cập nhật">↻</button>
                            }
                        </td>
                        <td class="text-end text-right align-middle text-danger font-weight-bold">
                            <strong>@item.TotalPrice.ToString("N0") VNĐ</strong>
                        </td>
                        <td class="text-center align-middle">
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { productID = item.product.ProductID })"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-secondary">
                    <td colspan="4" class="text-end text-right align-middle">
                        <h4 class="m-0"><strong>Tổng tiền thanh toán:</strong></h4>
                    </td>
                    <td class="text-end text-right align-middle">
                        <h4 class="text-danger m-0"><strong>@Model.TotalValue().ToString("N0") VNĐ</strong></h4>
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div class="row" style="margin-top:20px; margin-bottom:40px;">
            <div class="col-md-6 col-6">
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-secondary btn-lg">
                    ← Tiếp tục mua hàng
                </a>
            </div>
            <div class="col-md-6 col-6 text-end text-right">
                <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg">
                    Tiến hành thanh toán →
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5" style="padding:40px 0;">
            <h3>Giỏ hàng của bạn đang trống!</h3>
            <p>Hãy chọn thêm sản phẩm vào giỏ hàng để tiến hành mua sắm nhé.</p>
            <br />
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
                Khám phá sản phẩm ngay
            </a>
        </div>
    }
</div>